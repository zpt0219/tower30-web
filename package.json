{
  "name": "tower30-web",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "test": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build:core": "node scripts/godot/bundle.mjs",
    "build:godot": "npm run build:core && bash scripts/godot/native.sh && dotnet build integrations/godot/Tower30Proof.csproj -c Debug",
    "godot": "bash scripts/godot/run.sh",
    "test:godot": "bash scripts/godot/check.sh",
    "test:godot:ui": "bash scripts/godot/ui.sh",
    "test:godot:project": "bash scripts/godot/project-check.sh",
    "deploy:lan": "npm run build && python3 scripts/deploy-lan.py",
    "verify:lan": "node scripts/verify-lan.mjs",
    "apply:baseline": "python3 scripts/apply-baseline.py"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
